PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Producción: use NODE_ENV=production y un JWT_SECRET largo y único (obligatorio).
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_USER=admin
ADMIN_PASSWORD=123456

# En producción use la URL pública exacta del front, p. ej. https://su-dominio.com
CORS_ORIGIN=http://localhost:5173

# Opcional: ruta absoluta al archivo de datos (persistencia fuera del directorio del código).
# DATA_FILE=/var/lib/tres-regiones/data.json

BODY_LIMIT_BYTES=65536
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
